# ---- Providers: set BOTH the key and the model for each one you want enabled ----
# Model names are yours to choose; use the exact model id from the provider's docs.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Some newer models reject a custom temperature. Set to true to stop sending it.
# OPENAI_OMIT_TEMPERATURE=false
# ANTHROPIC_OMIT_TEMPERATURE=false

# Try the gateway with no real keys (echo provider; "[fail]" in a message simulates an outage)
ENABLE_MOCK=false

# Order to try providers in. Defaults to every enabled provider (openai, anthropic, gemini, groq).
# DEFAULT_ROUTE=anthropic,openai,groq

# ---- Access control ----
# Comma separated label:key pairs. Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEYS=alice:change-me-to-a-long-random-string
# Local development only. Never set this on a reachable server.
# GATEWAY_AUTH_DISABLED=false

# ---- Limits, cache, retries ----
RATE_LIMIT_PER_MINUTE=60        # per client; 0 disables
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=1000
# REDIS_URL=redis://localhost:6379/0   # share the cache across workers (needs the [redis] extra)
REQUEST_TIMEOUT=30
MAX_RETRIES=1
RETRY_BACKOFF_SECONDS=0.5

# ---- Cost tracking ----
# JSON price table, see prices.example.json. Without it, cost_usd is null (never guessed).
# PRICING_FILE=prices.json
DB_PATH=gateway_usage.db
